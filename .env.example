# Local dev defaults. On Railway, set DATABASE_URL to a path inside the mounted volume,
# e.g. file:/data/app.db
DATABASE_URL=file:./dev.db

# Optional Telegram alerts. If unset the app still works (sound + UI only).
# Create a bot at @BotFather, then get your chat id from @userinfobot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Override only if you need to point at a different host (rare).
# RTDS_HOST=wss://ws-live-data.polymarket.com
# GAMMA_BASE=https://gamma-api.polymarket.com
# NEXT_PUBLIC_POLYMARKET_BASE=https://polymarket.com

NEXT_PUBLIC_APP_NAME=PolyTape
# NEXT_PUBLIC_APP_SUBTITLE=Live Polymarket whale trade tape — large trades & clusters only
